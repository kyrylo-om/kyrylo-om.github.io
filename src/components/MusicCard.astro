---
const { data } = Astro.props;
import { Image } from 'astro:assets'

// Ensure path starts from root if not already provided
const audioSrc = data.audio;
const formattedDate = new Date(data.date).toLocaleDateString(undefined, {
    year: "numeric",
    month: "short",
    day: "numeric",
});
---

<div
	class="audio-player rounded-3xl p-4 shadow-lg bg-purple-500/10 border-2 border-purple-500 flex"
	data-url={audioSrc}
>
    <div class="flex flex-col grow">
        <div class="flex justify-center items-center">
            <div class="aspect-square size-30 relative">
                <Image 
                    src={data.thumbnail}
                    alt=""
                    class="object-cover object-center size-full rounded-xl"
                />
                <div class="absolute inset-0 object-cover object-center size-full bg-black/10 rounded-xl"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <button
                        type="button"
                        class="play-btn bg-indigo-600/30 hover:bg-indigo-500 text-white rounded-full size-15 transition flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-indigo-400"
                        aria-label="Play or Pause"
                    >
                        <svg class="play-icon size-12 fill-current" viewBox="0 0 24 24">
                            <path d="M8 5v14l11-7z"></path>
                        </svg>
                        <svg
                            class="pause-icon size-12 fill-current hidden"
                            viewBox="0 0 24 24"
                        >
                            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
                        </svg>
                    </button>
                </div>
            </div>
            <div class="grow flex flex-col justify-center mx-4">
                <div class="flex items-baseline">
                    <h3 class="text-xl font-bold">{data.title}</h3>
                </div>
                <div class="waveform-container grow cursor-pointer flex flex-col justify-center"></div>
                <div class="flex flex-col sm:flex-row">
                    <span class="time-display text-neutral-600 text-l truncate"
                        >0:00 / 0:00</span
                    >
                    <span class="text-neutral-600 text-l hidden sm:block">&nbsp;•&nbsp;</span>
                    <span class="text-neutral-600 text-l truncate">
                        {formattedDate}
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
	import WaveSurfer from "wavesurfer.js";

	const formatTime = (seconds: number) => {
		const minutes = Math.floor(seconds / 60);
		const remainingSeconds = Math.floor(seconds % 60);
		return `${minutes}:${remainingSeconds.toString().padStart(2, "0")}`;
	};

    const players = new Map<HTMLElement, WaveSurfer>();

    document.addEventListener("astro:page-load", () => {
        document
            .querySelectorAll<HTMLElement>(".audio-player")
            .forEach((container) => {
                const waveContainer = container.querySelector<HTMLElement>(
                    ".waveform-container",
                );
                const playBtn =
                    container.querySelector<HTMLButtonElement>(".play-btn");
                const playIcon = container.querySelector<SVGElement>(".play-icon");
                const pauseIcon =
                    container.querySelector<SVGElement>(".pause-icon");
                const timeDisplay =
                    container.querySelector<HTMLElement>(".time-display");
                const audioUrl = container.dataset.url;

                if (!waveContainer || !playBtn || !audioUrl) return;

                const ws = WaveSurfer.create({
                    container: waveContainer,
                    waveColor: "#4b5563",
                    progressColor: "#6366f1",
                    cursorColor: "#818cf8",
                    cursorWidth: 2,
                    height: 50,
                    barWidth: 3,
                    barGap: 3,
                    barRadius: 3,
                    url: audioUrl,
                });

				players.set(container, ws);

                const updatePlayState = (isPlaying: boolean) => {
                    playIcon?.classList.toggle("hidden", isPlaying);
                    pauseIcon?.classList.toggle("hidden", !isPlaying);
                };

                playBtn.addEventListener("click", () => ws.playPause());
                ws.on("play", () => {
                    players.forEach((otherPlayer, otherContainer) => {
                        if (otherContainer !== container) otherPlayer.pause();
                    });
                    updatePlayState(true);
                });
                ws.on("pause", () => updatePlayState(false));
                ws.on("finish", () => updatePlayState(false));

                ws.on("ready", (duration) => {
                    if (timeDisplay)
                        timeDisplay.textContent = `0:00 / ${formatTime(duration)}`;
                });

                ws.on("timeupdate", (currentTime) => {
                    const duration = ws.getDuration() || 0;
                    if (timeDisplay)
                        timeDisplay.textContent = `${formatTime(currentTime)} / ${formatTime(duration)}`;
                });
            });
        })
</script>
