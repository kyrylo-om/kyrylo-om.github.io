---
import { Image } from 'astro:assets'

const { data } = Astro.props
---

<div
    class="aspect-[1.26/1] text-4xl text-center cursor-pointer hover:scale-105 transition"
    data-game-card
    data-url={data.url}
>
    <Image 
        src={data.thumbnail}
        alt=""
        class="object-cover object-center size-full rounded-4xl border-5 border-orange-500"
    />
</div>

<script>
    document.querySelectorAll<HTMLElement>('[data-game-card]').forEach((card) => {
        card.addEventListener('click', () => {
            const url = card.dataset.url

            if (url) window.open(url, '_blank', 'noopener,noreferrer')
        })
    })
</script>