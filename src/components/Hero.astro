---
import "../styles/global.css";
import { getImage } from "astro:assets";
import bgsrc from "../assets/images/background.png";

const { category } = Astro.props as {
	category: "default" | "games" | "music" | "code" | "art" | "texts";
};

const pages = {
	"default": { path: "/", color: "bg-yellow-500/30" },
	"games": { path: "/videogames/", color: "bg-orange-500/30" },
	"music": { path: "/music/", color: "bg-purple-500/30" },
	"code": { path: "/code/", color: "bg-green-500/30" },
	"art": { path: "/art/", color: "bg-cyan-500/30" },
	"texts": { path: "/texts/", color: "bg-amber-900/30" },
} as const;

const page = pages[category];
const bg = await getImage({ src: bgsrc });
---

<script>
	import { navigate } from "astro:transitions/client";

	const pageOrder = [
        "/",
        "/videogames/",
        "/music/",
        "/code/",
        "/art/",
        "/texts/",
    ];
	
	document.addEventListener("astro:page-load", () => {
		
		function right() {
			const currentPath = window.location.pathname;
			const currentIndex = pageOrder.indexOf(currentPath);
			if (currentIndex < pageOrder.length - 1) {
				navigate(pageOrder[currentIndex + 1]);
			}
			else {
				navigate(pageOrder[0]);
			}
		}

		function left() {
			const currentPath = window.location.pathname;
			const currentIndex = pageOrder.indexOf(currentPath);
			if (currentIndex > 0) {
				navigate(pageOrder[currentIndex - 1]);
			}
			else {
				navigate(pageOrder[pageOrder.length - 1]);
			}
		}
		document.getElementById("btn-left")?.addEventListener("click", left);
		document.getElementById("btn-right")?.addEventListener("click", right);
		document.getElementById("scroll-down")?.addEventListener("click", () => {
			window.scrollBy({ top: window.innerHeight, behavior: "smooth" });
		});

		let touchStartX = 0;
		let touchStartY = 0;
		document.addEventListener("touchstart", (event) => {
			const touch = event.changedTouches[0];
			if (touch) {
				touchStartX = touch.clientX;
				touchStartY = touch.clientY;
			}
		}, { passive: true });
		document.addEventListener("touchend", (event) => {
			const touch = event.changedTouches[0];
			if (!touch) return;

			const deltaX = touch.clientX - touchStartX;
			const deltaY = touch.clientY - touchStartY;
			if (Math.abs(deltaX) < 50 || Math.abs(deltaX) <= Math.abs(deltaY)) return;

			if (deltaX < 0) {
				right();
			} else {
				left();
			}
		}, { passive: true });

		document.querySelectorAll(".category-dot").forEach((dot) => {
			dot.addEventListener("click", () => {
				const target = dot.getAttribute("data-path");
				if (target) {
					navigate(target);
				}
			});
		});
	});
</script>

<div
	transition:animate="none" transition:name="hero"
	class=`h-lvh w-screen ${page.color} fixed`
>
</div>
<div class="h-lvh w-screen flex flex-col justify-center items-center fixed sm:static">
	<div transition:animate="slide" transition:name="hero2" class="min-w-[88vw] sm:min-w-[70vw] min-h-[70vh] flex flex-row items-stretch justify-center rounded-2xl p-2 sm:p-6">
		<div class="flex flex-col justify-center items-center">
			<h1 transition:animate="fade" transition:name="hero3" class="text-center text-6xl sm:text-8xl m-4 sm:m-4 text-shadow-black/20 text-shadow-lg" style=`font-family: var(--font-${category});`>
				Creative Space
			</h1>
			<div class="text-xl sm:text-4xl text-center">
				<slot name="subtitle" />
			</div>
			<div id="scroll-down" class="p-3 sm:p-4 px-10 sm:px-20 m-2 sm:m-4 cursor-pointer rounded-2xl text-sm sm:text-2xl outline-2 outline-black/50 hover:bg-black/3">
				<slot name="button" />
			</div>
			<div class="flex items-center justify-center gap-3" transition:animate="none" transition:name="hero4">
				<div id="btn-left" class="p-1 flex items-center cursor-pointer">
					<p class="text-2xl sm:text-4xl text-black/40 hover:text-black/60">
						<svg viewBox="0 0 24 24" class="size-[1em]" fill="currentColor" aria-hidden="true">
							<path d="M18.5 3.5c1.2-.9 2.9 0 2.9 1.5v14c0 1.5-1.7 2.4-2.9 1.5l-10-7c-1-.7-1-2.3 0-3l10-7Z" />
						</svg>
					</p>
				</div>
				{Object.entries(pages).map(([dotCategory, { path }]) => {
					const isCurrent = path === Astro.url.pathname;
	
					return (
						<button
							type="button"
							class:list={[
								"category-dot",
								"rounded-full border border-black/20 transition-all duration-200 hover:scale-110 hover:bg-black/40 focus:outline-none focus:ring-2 focus:ring-black/30",
								isCurrent ? "size-3 sm:size-4 bg-black/80 shadow-md" : "size-2 sm:size-3 bg-black/30",
							]}
							data-path={path}
							aria-label={`Go to ${dotCategory === "default" ? "home" : dotCategory} page`}
							title={dotCategory === "default" ? "Home" : dotCategory}
						/>
					);
				})}
				<div id="btn-right" class="rounded-2xl p-1 flex items-center cursor-pointer">
					<p class="text-2xl sm:text-4xl text-black/40 hover:text-black/60">
						<svg viewBox="0 0 24 24" class="size-[1em]" fill="currentColor" aria-hidden="true">
							<path d="M5.5 3.5c-1.2-.9-2.9 0-2.9 1.5v14c0 1.5 1.7 2.4 2.9 1.5l10-7c1-.7 1-2.3 0-3l-10-7Z" />
						</svg>
					</p>
				</div>
			</div>
		</div>
</div>
</div>
