---
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryLayout from '../layouts/CategoryLayout.astro';

import '../styles/global.css'
---

<script>
import { gsap } from "gsap";

const box = document.getElementById("box");
const myTimeline = gsap.timeline();

myTimeline
    // .from(box, {
    //     opacity: 0,
	// 	duration: 0.1,
    // })
    .to(box, {
        opacity: 1,
        duration: 4,
    })
</script>

<BaseLayout pageTitle="Index">
	<CategoryLayout category="default">
        <Hero slot="hero" category="default">
            <p slot="subtitle">So, uh... I like a lot of things.</p>
            <p slot="button">Hi there!</p>
        </Hero>
        <p slot="title">Hello.</p>
        <div slot="content" class="flex flex-col items-center">
            Work in progress
        </div>
    </CategoryLayout>
</BaseLayout>
