---
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryLayout from '../layouts/CategoryLayout.astro';

import '../styles/global.css'
---

<BaseLayout pageTitle="Art">
	<CategoryLayout category="art">
        <Hero slot="hero" category="art">
            <p slot="subtitle">I like to draw sometimes!</p>
            <p slot="button">Look 👀</p>
        </Hero>
        <p slot="title">Art</p>
	</CategoryLayout>
</BaseLayout>
