---
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryLayout from '../layouts/CategoryLayout.astro';
import MusicCard from '../components/MusicCard.astro'

import '../styles/global.css'

import { getCollection } from 'astro:content';

const posts = await getCollection('music');
---

<BaseLayout pageTitle="Music">
	<CategoryLayout category="music">
        <Hero slot="hero" category="music">
            <p slot="subtitle">I love making music.</p>
            <p slot="button">Have a listen!</p>
        </Hero>
		<p slot="title">Music</p>
        <div slot="content">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                {posts.map((post) => (
                <MusicCard data={post.data}>
                    <p slot="title">{post.data.title}</p>
                </MusicCard>
                ))}
            </div>
        </div>
	</CategoryLayout>
</BaseLayout>
